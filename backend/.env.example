PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hostel_entry
JWT_SECRET=change-me-to-a-long-random-string
# Timezone used for "today", gate closure and reminders
APP_TZ=Asia/Kolkata
# Needed to register a new warden account
WARDEN_INVITE_CODE=change-me-warden-code
# If true, students can only mark an exit between the hostel's out_time and gate_closure_time
ENFORCE_EXIT_WINDOW=true
# Frontend origin allowed by CORS (dev server default)
CORS_ORIGIN=http://localhost:5173
# Set to "false" to disable the built-in 9 PM alert job (e.g. when running multiple instances)
ALERT_JOB_ENABLED=true
